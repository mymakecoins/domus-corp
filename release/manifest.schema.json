{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domus.corp/schemas/release-manifest/v1",
  "type": "object",
  "required": ["issue", "version", "classification", "summary", "impact", "risks", "tests", "evidence", "rollback", "rings", "findings", "contractsVersion"],
  "properties": {
    "issue": {"type": "string", "pattern": "^V1-[0-9]{3}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
    "classification": {"enum": ["low", "moderate", "high-p0"]},
    "summary": {"type": "string", "minLength": 10},
    "impact": {"type": "string", "minLength": 10},
    "risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "result"], "properties": {"name": {"type": "string"}, "result": {"enum": ["passed", "failed"]}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback": {"type": "object", "required": ["runbook", "dataCompatibility"], "properties": {"runbook": {"type": "string"}, "dataCompatibility": {"type": "string", "minLength": 10}}},
    "rings": {"type": "array", "minItems": 1, "items": {"enum": ["internal", "pilot", "gradual", "stable"]}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "contractsVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "severity", "status"],
      "properties": {
        "id": {"type": "string"},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "status": {"enum": ["open", "fixed", "accepted"]},
        "acceptance": {"type": "object", "required": ["owner", "role", "acceptedAt", "expiresAt", "justification"], "properties": {"owner": {"type": "string"}, "role": {"enum": ["Security Lead", "Risk Owner"]}, "acceptedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"}, "justification": {"type": "string", "minLength": 10}}
      }
    }
  }
}
