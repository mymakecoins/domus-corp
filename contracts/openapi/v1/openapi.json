{
  "openapi": "3.1.0",
  "info": { "title": "Domus cross-runtime HTTP API", "version": "1.0.0", "description": "Interfaces internas; autenticação de workload é obrigatória no transporte." },
  "servers": [{ "url": "https://internal.invalid/v1" }],
  "paths": {
    "/policy/effective": { "post": { "operationId": "resolveEffectivePolicy", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../json-schema/v1/effective-policy.schema.json" } } } }, "responses": { "200": { "description": "Policy efetiva", "content": { "application/json": { "schema": { "$ref": "../../json-schema/v1/effective-policy.schema.json" } } } }, "default": { "$ref": "#/components/responses/ContractError" } } } },
    "/knowledge/assets": { "post": { "operationId": "acceptKnowledgeAsset", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../json-schema/v1/knowledge-asset.schema.json" } } } }, "responses": { "202": { "description": "Ativo aceito para processamento", "content": { "application/json": { "schema": { "$ref": "../../json-schema/v1/knowledge-asset.schema.json" } } } }, "default": { "$ref": "#/components/responses/ContractError" } } } },
    "/retrieval/evidence": { "post": { "operationId": "retrieveEvidence", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../json-schema/v1/effective-policy.schema.json" } } } }, "responses": { "200": { "description": "Evidências autorizadas", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "../../json-schema/v1/evidence.schema.json" } } } } }, "default": { "$ref": "#/components/responses/ContractError" } } } },
    "/intelligence/insights": { "post": { "operationId": "publishInsight", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../json-schema/v1/insight.schema.json" } } } }, "responses": { "202": { "description": "Insight recebido", "content": { "application/json": { "schema": { "$ref": "../../json-schema/v1/insight.schema.json" } } } }, "default": { "$ref": "#/components/responses/ContractError" } } } },
    "/actions": { "post": { "operationId": "proposeAction", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../json-schema/v1/action-request.schema.json" } } } }, "responses": { "202": { "description": "Proposta recebida; não implica execução", "content": { "application/json": { "schema": { "$ref": "../../json-schema/v1/action-request.schema.json" } } } }, "default": { "$ref": "#/components/responses/ContractError" } } } }
  },
  "components": { "responses": { "ContractError": { "description": "Bloqueio tipado e fail-closed", "content": { "application/problem+json": { "schema": { "$ref": "../../json-schema/v1/contract-error.schema.json" } } } } } }
}
