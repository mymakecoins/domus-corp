    "properties": { "schema_version":{},"request_id":{},"tenant_id":{},"workspace_id":{},"policy_version":{},"classification":{},"provenance":{},
      "asset_id":{"$ref":"common.schema.json#/$defs/uuid"},"owner_id":{"$ref":"common.schema.json#/$defs/uuid"},"content_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"media_type":{"type":"string","minLength":1},"state":{"type":"string","enum":["pending","active","quarantined","expired","deleted"]},"created_at":{"$ref":"common.schema.json#/$defs/timestamp"},"valid_until":{"$ref":"common.schema.json#/$defs/timestamp"}
    }
  }]
