{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.domus.corp/v1/source-connection.schema.json","title":"SourceConnection","type":"object","additionalProperties":false,"required":["schema_version","connection_id","tenant_id","workspace_id","source_id","adapter_key","adapter_version","credential_ref","granted_scopes","state","cursor_version","fencing_token","attempt","version"],"properties":{"schema_version":{"type":"string","const":"1.0.0"},"connection_id":{"$ref":"common.schema.json#/$defs/uuid"},"tenant_id":{"$ref":"common.schema.json#/$defs/uuid"},"workspace_id":{"$ref":"common.schema.json#/$defs/uuid"},"source_id":{"$ref":"common.schema.json#/$defs/uuid"},"adapter_key":{"type":"string","pattern":"^[a-z][a-z0-9._-]{0,63}$"},"adapter_version":{"type":"integer","minimum":1},"credential_ref":{"type":"string","pattern":"^vaultref:[a-z0-9._/-]+#[1-9][0-9]*$"},"granted_scopes":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160}},"state":{"type":"string","enum":["PENDING","READY","SYNCING","BACKOFF","PAUSED","REVOKED","DEAD_LETTER"]},"cursor_version":{"type":"integer","minimum":0},"fencing_token":{"type":"integer","minimum":0},"attempt":{"type":"integer","minimum":0,"maximum":8},"last_error_code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,119}$"},"version":{"type":"integer","minimum":1}}}
