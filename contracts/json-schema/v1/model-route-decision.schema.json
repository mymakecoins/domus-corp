{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.domus.corp/v1/model-route-decision.schema.json",
  "title":"ModelRouteDecision",
  "allOf":[
    {"$ref":"common.schema.json#/$defs/envelope"},
    {
      "type":"object","additionalProperties":false,
      "required":["schema_version","request_id","tenant_id","workspace_id","policy_version","classification","provenance","fallback_chain","decision","deny_reasons","routed_at"],
      "properties":{
        "schema_version":{},"request_id":{},"tenant_id":{},"workspace_id":{},"policy_version":{},"classification":{},"provenance":{},
        "catalog_version":{"type":"integer","minimum":1},
        "model_key":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,62}$"},
        "provider_key":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,62}$"},
        "price_version":{"type":"integer","minimum":1},
        "currency":{"type":"string","pattern":"^[A-Z]{3}$"},
        "maximum_estimated_cost_minor":{"type":"integer","minimum":0},
        "fallback_chain":{"type":"array","maxItems":4,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,62}$"}},
        "decision":{"type":"string","enum":["ALLOW","DENY"]},
        "deny_reasons":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "routed_at":{"$ref":"common.schema.json#/$defs/timestamp"}
      }
    }
  ]
}
