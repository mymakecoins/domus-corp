{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.domus.corp/v1/source-registry-entry.schema.json","title":"SourceRegistryEntry","type":"object","additionalProperties":false,
  "required":["schema_version","source_id","tenant_id","workspace_id","name","purpose","source_type","origin_system_key","connector_key","owner_acceptance","schedule_mode","freshness_sla_seconds","retention_days","status","ingestion_eligible","version","created_at","updated_at"],
  "properties":{"schema_version":{"type":"string","const":"1.0.0"},"source_id":{"$ref":"common.schema.json#/$defs/uuid"},"tenant_id":{"$ref":"common.schema.json#/$defs/uuid"},"workspace_id":{"$ref":"common.schema.json#/$defs/uuid"},"name":{"type":"string","minLength":1,"maxLength":160},"purpose":{"type":"string","minLength":1,"maxLength":1000},"source_type":{"type":"string","pattern":"^[a-z][a-z0-9._-]{0,63}$"},"origin_system_key":{"type":"string","pattern":"^[a-z][a-z0-9._-]{0,63}$"},"connector_key":{"type":"string","pattern":"^[a-z][a-z0-9._-]{0,63}$"},"owner_user_id":{"$ref":"common.schema.json#/$defs/uuid"},"owner_acceptance":{"type":"string","enum":["PENDING","ACCEPTED"]},"classification":{"$ref":"common.schema.json#/$defs/classification"},"schedule_mode":{"type":"string","enum":["MANUAL","SCHEDULED"]},"sync_interval_seconds":{"type":"integer","minimum":300,"maximum":2592000},"freshness_sla_seconds":{"type":"integer","minimum":300,"maximum":31536000},"retention_days":{"type":"integer","minimum":1,"maximum":3650},"status":{"type":"string","enum":["DRAFT","PENDING_OWNER","PENDING_REVIEW","ACTIVE","PAUSED","DISCONNECTED","ARCHIVED"]},"status_reason":{"type":"string","minLength":1,"maxLength":500},"ingestion_eligible":{"type":"boolean"},"version":{"type":"integer","minimum":1},"created_at":{"$ref":"common.schema.json#/$defs/timestamp"},"updated_at":{"$ref":"common.schema.json#/$defs/timestamp"}}
}
