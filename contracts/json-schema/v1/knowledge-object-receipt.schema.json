{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.domus.corp/v1/knowledge-object-receipt.schema.json","title":"KnowledgeObjectReceipt","type":"object","additionalProperties":false,"required":["schema_version","request_id","tenant_id","workspace_id","source_id","asset_id","version_id","classification","media_type","size_bytes","checksum","state","retention_days","object_version","created_at"],"properties":{"schema_version":{"type":"string","const":"1.0.0"},"request_id":{"$ref":"common.schema.json#/$defs/uuid"},"tenant_id":{"$ref":"common.schema.json#/$defs/uuid"},"workspace_id":{"$ref":"common.schema.json#/$defs/uuid"},"source_id":{"$ref":"common.schema.json#/$defs/uuid"},"asset_id":{"$ref":"common.schema.json#/$defs/uuid"},"version_id":{"$ref":"common.schema.json#/$defs/uuid"},"classification":{"$ref":"common.schema.json#/$defs/classification"},"media_type":{"type":"string","minLength":1,"maxLength":160},"size_bytes":{"type":"integer","minimum":1,"maximum":104857600},"checksum":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"state":{"type":"string","enum":["AVAILABLE","QUARANTINED","REJECTED"]},"retention_days":{"type":"integer","minimum":1,"maximum":3650},"object_version":{"type":"string","minLength":1,"maxLength":256},"created_at":{"$ref":"common.schema.json#/$defs/timestamp"}}}
