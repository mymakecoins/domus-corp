{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.domus.corp/v1/cost-ledger-entry.schema.json","title":"CostLedgerEntry","type":"object","additionalProperties":false,"required":["schema_version","tenant_id","workspace_id","user_id","entry_id","request_id","reservation_id","provider_key","model_key","task_type","policy_version","catalog_version","price_version","currency","estimated_minor","input_tokens","output_tokens","state","occurred_at"],"properties":{"schema_version":{"const":"1.0.0"},"tenant_id":{"type":"string","format":"uuid"},"workspace_id":{"type":"string","format":"uuid"},"user_id":{"type":"string","format":"uuid"},"entry_id":{"type":"string","format":"uuid"},"request_id":{"type":"string","format":"uuid"},"reservation_id":{"type":"string","format":"uuid"},"provider_key":{"type":"string","minLength":1},"model_key":{"type":"string","minLength":1},"tool_id":{"type":"string","minLength":1},"task_type":{"type":"string","minLength":1},"policy_version":{"type":"string","minLength":1},"catalog_version":{"type":"integer","minimum":1},"price_version":{"type":"integer","minimum":1},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"estimated_minor":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},"actual_minor":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},"input_tokens":{"type":"integer","minimum":0},"output_tokens":{"type":"integer","minimum":0},"receipt_id":{"type":"string","minLength":1},"state":{"type":"string","enum":["RESERVED","COMMITTED","RELEASED","EXPIRED","RECONCILIATION_REVIEW"]},"occurred_at":{"type":"string","format":"date-time"}}}
