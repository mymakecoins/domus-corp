{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.domus.corp/v1/normalized-knowledge-artifact-manifest.schema.json","title":"NormalizedKnowledgeArtifactManifest","type":"object","additionalProperties":false,"required":["schema_version","tenant_id","workspace_id","source_id","asset_id","asset_version_id","parser_profile","parser_version","media_type","kind","language","classification","original_checksum","normalized_checksum","artifact_ref","size_bytes","unit_count"],"properties":{"schema_version":{"const":"1.0.0"},"tenant_id":{"$ref":"common.schema.json#/$defs/uuid"},"workspace_id":{"$ref":"common.schema.json#/$defs/uuid"},"source_id":{"$ref":"common.schema.json#/$defs/uuid"},"asset_id":{"$ref":"common.schema.json#/$defs/uuid"},"asset_version_id":{"$ref":"common.schema.json#/$defs/uuid"},"parser_profile":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,31}$"},"parser_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"media_type":{"enum":["text/plain","application/json","text/csv","application/pdf"]},"kind":{"enum":["text","pages","records"]},"language":{"type":"string","pattern":"^(und|[a-z]{2})$"},"language_confidence":{"type":"number","minimum":0,"maximum":1},"classification":{"$ref":"common.schema.json#/$defs/classification"},"original_checksum":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"normalized_checksum":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"artifact_ref":{"type":"string","pattern":"^artifactref:[a-zA-Z0-9/_:.-]{1,512}$"},"size_bytes":{"type":"integer","minimum":0,"maximum":52428800},"unit_count":{"type":"integer","minimum":0,"maximum":1000000},"warnings":{"type":"array","maxItems":32,"items":{"type":"string","maxLength":64},"uniqueItems":true}}}
