{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.domus.corp/v1/external-identity.schema.json",
  "title": "ExternalIdentity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issuer", "subject", "audiences", "issued_at", "expires_at", "external_groups", "claims_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "issuer": {"type": "string", "format": "uri", "pattern": "^https://"},
    "subject": {"type": "string", "minLength": 1},
    "audiences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "issued_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "auth_time": {"$ref": "common.schema.json#/$defs/timestamp"},
    "external_groups": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "external_tenant_hints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claims_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
