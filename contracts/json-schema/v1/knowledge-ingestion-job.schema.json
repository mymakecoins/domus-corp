{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.domus.corp/v1/knowledge-ingestion-job.schema.json","title":"KnowledgeIngestionJob","type":"object","additionalProperties":false,"required":["schema_version","job_id","request_id","trace_id","tenant_id","workspace_id","source_id","asset_id","asset_version_id","object_version","original_checksum","media_type","classification","policy_version","parser_profile","parser_version","fencing_token"],"properties":{"schema_version":{"const":"1.0.0"},"job_id":{"$ref":"common.schema.json#/$defs/uuid"},"request_id":{"$ref":"common.schema.json#/$defs/uuid"},"trace_id":{"type":"string","pattern":"^[a-f0-9]{32}$"},"tenant_id":{"$ref":"common.schema.json#/$defs/uuid"},"workspace_id":{"$ref":"common.schema.json#/$defs/uuid"},"source_id":{"$ref":"common.schema.json#/$defs/uuid"},"asset_id":{"$ref":"common.schema.json#/$defs/uuid"},"asset_version_id":{"$ref":"common.schema.json#/$defs/uuid"},"object_version":{"type":"string","minLength":1,"maxLength":256},"original_checksum":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"media_type":{"enum":["text/plain","application/json","text/csv","application/pdf"]},"classification":{"$ref":"common.schema.json#/$defs/classification"},"policy_version":{"type":"string","minLength":1,"maxLength":256},"parser_profile":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,31}$"},"parser_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"fencing_token":{"type":"integer","minimum":1}}}
