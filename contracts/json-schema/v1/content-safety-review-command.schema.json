{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.domus.corp/v1/content-safety-review-command.schema.json","title":"ContentSafetyReviewCommand","type":"object","additionalProperties":false,"required":["schema_version","request_id","tenant_id","workspace_id","assessment_id","decision","reason","expected_version"],"properties":{"schema_version":{"const":"1.0.0"},"request_id":{"$ref":"common.schema.json#/$defs/uuid"},"tenant_id":{"$ref":"common.schema.json#/$defs/uuid"},"workspace_id":{"$ref":"common.schema.json#/$defs/uuid"},"assessment_id":{"type":"string","pattern":"^[a-f0-9]{64}$"},"decision":{"enum":["RELEASE","KEEP_QUARANTINED","REJECT"]},"reason":{"type":"string","minLength":10,"maxLength":1000},"expected_version":{"type":"integer","minimum":1}}}
