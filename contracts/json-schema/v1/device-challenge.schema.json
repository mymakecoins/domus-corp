{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.domus.corp/v1/device-challenge.schema.json",
  "title": "DeviceChallenge",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nonce", "audience", "expires_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "audience": {"type": "string", "const": "domus-device-registration"},
    "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
