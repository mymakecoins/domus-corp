{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.domus.corp/v1/knowledge-ingestion-result.schema.json","title":"KnowledgeIngestionResult","type":"object","additionalProperties":false,"required":["schema_version","job_id","request_id","tenant_id","workspace_id","asset_id","asset_version_id","parser_version","state","original_checksum","occurred_at"],"properties":{"schema_version":{"const":"1.0.0"},"job_id":{"$ref":"common.schema.json#/$defs/uuid"},"request_id":{"$ref":"common.schema.json#/$defs/uuid"},"tenant_id":{"$ref":"common.schema.json#/$defs/uuid"},"workspace_id":{"$ref":"common.schema.json#/$defs/uuid"},"asset_id":{"$ref":"common.schema.json#/$defs/uuid"},"asset_version_id":{"$ref":"common.schema.json#/$defs/uuid"},"parser_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"state":{"enum":["QUEUED","RUNNING","RETRY_WAIT","SUCCEEDED","FAILED","QUARANTINED","CANCELLED"]},"original_checksum":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"normalized_checksum":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"artifact_ref":{"type":"string","pattern":"^artifactref:[a-zA-Z0-9/_:.-]{1,512}$"},"error_code":{"enum":["OBJECT_UNAVAILABLE","INTEGRITY_MISMATCH","UNSUPPORTED_MEDIA_TYPE","INVALID_ENCODING","CORRUPT_CONTENT","ENCRYPTED_CONTENT","PARSER_TIMEOUT","PARSER_RESOURCE_LIMIT","PARSER_UNAVAILABLE","OUTPUT_INVALID","DEPENDENCY_UNAVAILABLE"]},"occurred_at":{"$ref":"common.schema.json#/$defs/timestamp"}}}
