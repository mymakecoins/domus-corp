{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domus.corp/schemas/v1/knowledge-embedding-v1.schema.json",
  "title": "KnowledgeEmbeddingV1",
  "type": "object",
  "required": [
    "embedding_id",
    "chunk_id",
    "model_profile",
    "model_version",
    "dimensions",
    "vector_checksum",
    "index_version",
    "status"
  ],
  "properties": {
    "embedding_id": { "type": "string" },
    "chunk_id": { "type": "string" },
    "model_profile": { "type": "string" },
    "model_version": { "type": "string" },
    "dimensions": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "vector_checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "index_version": { "type": "string" },
    "status": { "type": "string", "enum": ["READY", "REMOVED"] }
  },
  "additionalProperties": false
}
