{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.domus.corp/v1/model-stream-event.schema.json",
  "title": "ModelStreamEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "sequence", "type", "occurred_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "request_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 0 },
    "type": { "type": "string", "enum": ["started", "delta", "completed", "cancelled", "failed"] },
    "text": { "type": "string" },
    "code": { "type": "string", "enum": ["RATE_LIMITED", "CONCURRENCY_LIMITED", "PROVIDER_CIRCUIT_OPEN", "PROVIDER_TIMEOUT", "STREAM_LIMIT_EXCEEDED", "PROVIDER_RESPONSE_INCONCLUSIVE"] },
    "receipt_id": { "type": "string", "minLength": 1 },
    "actual_minor": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "retry_after_seconds": { "type": "integer", "minimum": 1 },
    "semantic_state": { "type": "string", "enum": ["fundamentada", "parcial", "conflitante", "inferida", "sem-evidencia", "obsoleta", "bloqueada", "inconclusiva"] },
    "citation_refs": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
