{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.domus.corp/v1/cost-threshold-event.schema.json","title":"CostThresholdEvent","type":"object","additionalProperties":false,"required":["schema_version","tenant_id","event_id","scope_type","scope_id","threshold","percent","currency","policy_version","occurred_at","cooldown_until"],"properties":{"schema_version":{"const":"1.0.0"},"tenant_id":{"type":"string","format":"uuid"},"event_id":{"type":"string","format":"uuid"},"scope_type":{"type":"string","enum":["tenant","workspace","user","task","provider"]},"scope_id":{"type":"string","minLength":1},"threshold":{"type":"integer","enum":[80,100]},"percent":{"type":"integer","minimum":0},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"policy_version":{"type":"string","minLength":1},"occurred_at":{"type":"string","format":"date-time"},"cooldown_until":{"type":"string","format":"date-time"}}}
