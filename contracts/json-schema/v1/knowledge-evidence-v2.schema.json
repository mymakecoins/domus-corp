{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"KnowledgeEvidenceV2","type":"object","additionalProperties":false,"required":["schema_version","evidence_id","tenant_id","workspace_id","source_id","asset_id","version_id","classification","locator_kind","locator_value","original_checksum","normalized_checksum","excerpt_hash","status"],"properties":{"schema_version":{"const":"1.0.0"},"evidence_id":{"$ref":"common.schema.json#/$defs/uuid"},"tenant_id":{"$ref":"common.schema.json#/$defs/uuid"},"workspace_id":{"$ref":"common.schema.json#/$defs/uuid"},"source_id":{"$ref":"common.schema.json#/$defs/uuid"},"asset_id":{"$ref":"common.schema.json#/$defs/uuid"},"version_id":{"$ref":"common.schema.json#/$defs/uuid"},"classification":{"$ref":"common.schema.json#/$defs/classification"},"locator_kind":{"enum":["page","section","record","offset"]},"locator_value":{"type":"string","minLength":1,"maxLength":256},"original_checksum":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"normalized_checksum":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"excerpt_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"status":{"enum":["VALID","INVALID"]}}}
