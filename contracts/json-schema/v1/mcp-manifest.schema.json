{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.domus.corp/v1/mcp-manifest.schema.json",
  "title": "McpManifest",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "tenant_id",
        "workspace_id",
        "policy_version",
        "classification",
        "provenance",
        "server_id",
        "name",
        "description",
        "owner_user_id",
        "endpoint_url",
        "tools",
        "enabled",
        "status",
        "allowed_workspaces",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "schema_version": {},
        "request_id": {},
        "tenant_id": {},
        "workspace_id": {},
        "policy_version": {},
        "classification": {},
        "provenance": {},
        "server_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "owner_user_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "endpoint_url": { "type": "string", "format": "uri" },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool_id", "name", "description", "risk_level", "parameters_schema"],
            "properties": {
              "tool_id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "risk_level": { "type": "string", "enum": ["low", "medium", "high", "irreversible"] },
              "parameters_schema": { "type": "object" }
            }
          }
        },
        "enabled": { "type": "boolean", "default": false },
        "status": { "type": "string", "enum": ["PENDING_SECURITY_APPROVAL", "APPROVED", "REVOKED"] },
        "allowed_workspaces": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/uuid" }
        },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    }
  ]
}
