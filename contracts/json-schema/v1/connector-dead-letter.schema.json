{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.domus.corp/v1/connector-dead-letter.schema.json","title":"ConnectorDeadLetter","type":"object","additionalProperties":false,"required":["schema_version","dead_letter_id","tenant_id","workspace_id","connection_id","execution_id","error_code","error_hash","attempts","state","created_at","expires_at"],"properties":{"schema_version":{"type":"string","const":"1.0.0"},"dead_letter_id":{"$ref":"common.schema.json#/$defs/uuid"},"tenant_id":{"$ref":"common.schema.json#/$defs/uuid"},"workspace_id":{"$ref":"common.schema.json#/$defs/uuid"},"connection_id":{"$ref":"common.schema.json#/$defs/uuid"},"execution_id":{"$ref":"common.schema.json#/$defs/uuid"},"error_code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,119}$"},"error_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"attempts":{"type":"integer","minimum":1,"maximum":8},"state":{"type":"string","enum":["PENDING","REQUEUED","DISCARDED"]},"justification":{"type":"string","minLength":1,"maxLength":500},"created_at":{"$ref":"common.schema.json#/$defs/timestamp"},"expires_at":{"$ref":"common.schema.json#/$defs/timestamp"}}}
