{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.domus.corp/v1/content-safety-event.schema.json","title":"ContentSafetyEvent","type":"object","additionalProperties":false,"required":["schema_version","event_id","event_type","request_id","tenant_id","workspace_id","assessment_id","asset_id","version_id","normalized_checksum","scanner_version","decision","assessment_version","occurred_at"],"properties":{"schema_version":{"const":"1.0.0"},"event_id":{"$ref":"common.schema.json#/$defs/uuid"},"event_type":{"enum":["knowledge.safety.assessed.v1","knowledge.safety.review_required.v1","knowledge.safety.quarantined.v1","knowledge.safety.released.v1","knowledge.safety.rejected.v1","knowledge.safety.blocked.v1"]},"request_id":{"$ref":"common.schema.json#/$defs/uuid"},"tenant_id":{"$ref":"common.schema.json#/$defs/uuid"},"workspace_id":{"$ref":"common.schema.json#/$defs/uuid"},"assessment_id":{"type":"string","pattern":"^[a-f0-9]{64}$"},"asset_id":{"$ref":"common.schema.json#/$defs/uuid"},"version_id":{"$ref":"common.schema.json#/$defs/uuid"},"normalized_checksum":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"scanner_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"decision":{"enum":["ALLOW_WITH_MARKERS","REVIEW_REQUIRED","QUARANTINE","BLOCK"]},"assessment_version":{"type":"integer","minimum":1},"occurred_at":{"$ref":"common.schema.json#/$defs/timestamp"}}}
