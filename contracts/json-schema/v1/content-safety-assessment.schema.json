{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.domus.corp/v1/content-safety-assessment.schema.json","title":"ContentSafetyAssessment","type":"object","additionalProperties":false,"required":["schema_version","assessment_id","tenant_id","workspace_id","source_id","asset_id","version_id","normalized_checksum","classification","policy_version","scanner_profile","scanner_version","trust_origin","score","decision","findings","assessed_at","version"],"properties":{"schema_version":{"const":"1.0.0"},"assessment_id":{"type":"string","pattern":"^[a-f0-9]{64}$"},"tenant_id":{"$ref":"common.schema.json#/$defs/uuid"},"workspace_id":{"$ref":"common.schema.json#/$defs/uuid"},"source_id":{"$ref":"common.schema.json#/$defs/uuid"},"asset_id":{"$ref":"common.schema.json#/$defs/uuid"},"version_id":{"$ref":"common.schema.json#/$defs/uuid"},"normalized_checksum":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"classification":{"$ref":"common.schema.json#/$defs/classification"},"policy_version":{"type":"string","minLength":1,"maxLength":256},"scanner_profile":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,31}$"},"scanner_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"trust_origin":{"const":"UNTRUSTED_EXTERNAL_DATA"},"score":{"type":"number","minimum":0,"maximum":1},"decision":{"enum":["ALLOW_WITH_MARKERS","REVIEW_REQUIRED","QUARANTINE","BLOCK"]},"findings":{"type":"array","maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["finding_id","category","severity","confidence","locator"],"properties":{"finding_id":{"type":"string","pattern":"^[a-f0-9]{64}$"},"category":{"enum":["INSTRUCTION_OVERRIDE","EXFILTRATION","TOOL_COERCION","OBFUSCATION","ROLE_SPOOFING"]},"severity":{"enum":["MEDIUM","CRITICAL"]},"confidence":{"type":"number","minimum":0,"maximum":1},"locator":{"type":"string","maxLength":128}}}},"assessed_at":{"$ref":"common.schema.json#/$defs/timestamp"},"version":{"type":"integer","minimum":1}}}
