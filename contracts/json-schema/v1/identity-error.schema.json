{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.domus.corp/v1/identity-error.schema.json",
  "title": "IdentityError",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "error_id", "request_id", "occurred_at", "code", "http_status", "message", "retryable"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "error_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "request_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "occurred_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "code": {"type": "string", "enum": ["IDENTITY_TOKEN_INVALID", "IDENTITY_TOKEN_EXPIRED", "IDENTITY_ISSUER_INVALID", "IDENTITY_AUDIENCE_INVALID", "IDENTITY_CLAIM_MISSING", "TENANT_CONTEXT_INVALID", "WORKSPACE_ACCESS_DENIED", "DEVICE_NOT_REGISTERED", "DEVICE_REVOKED", "IDENTITY_DEPENDENCY_UNAVAILABLE", "IDENTITY_CONTRACT_VERSION_UNSUPPORTED"]},
    "http_status": {"type": "integer", "enum": [401, 403, 503]},
    "message": {"type": "string", "minLength": 1},
    "retryable": {"type": "boolean"},
    "tenant_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "user_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "device_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "workspace_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "session_id": {"$ref": "common.schema.json#/$defs/uuid"}
  }
}
