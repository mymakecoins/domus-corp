{
  "asyncapi": "3.0.0",
  "info": { "title": "Domus cross-runtime events and jobs", "version": "1.10.0" },
  "defaultContentType": "application/json",
  "channels": {
    "identityEvents": { "address": "domus.v1.identity.events", "messages": { "identityEvent": { "$ref": "#/components/messages/IdentityEvent" } } },
    "tenancyEvents": { "address": "domus.v1.tenancy.events", "messages": { "tenancyEvent": { "$ref": "#/components/messages/TenancyEvent" } } },
    "knowledgeEvents": { "address": "domus.v1.knowledge.events", "messages": { "domainEvent": { "$ref": "#/components/messages/DomainEvent" } } },
    "intelligenceEvents": { "address": "domus.v1.intelligence.events", "messages": { "domainEvent": { "$ref": "#/components/messages/DomainEvent" } } },
    "actionEvents": { "address": "domus.v1.action.events", "messages": { "domainEvent": { "$ref": "#/components/messages/DomainEvent" } } },
    "ingestionJobs": { "address": "domus.v1.ingestion.jobs", "messages": { "knowledgeAsset": { "$ref": "#/components/messages/KnowledgeAssetJob" } } },
    "sourceEvents": { "address": "domus.v1.source.events", "messages": { "sourceEvent": { "$ref": "#/components/messages/SourceLifecycleEvent" } } },
    "connectorJobs": { "address": "domus.v1.connector.jobs", "messages": { "connectorJob": { "$ref": "#/components/messages/ConnectorSyncJob" } } },
    "connectorEvents": { "address": "domus.v1.connector.events", "messages": { "connectorEvent": { "$ref": "#/components/messages/ConnectorSyncEvent" } } },
    "knowledgeObjectEvents": { "address": "domus.v1.knowledge.objects", "messages": { "knowledgeObjectEvent": { "$ref": "#/components/messages/KnowledgeObjectEvent" } } },
    "knowledgeIngestionJobs": { "address": "domus.v1.knowledge.ingestion.jobs", "messages": { "ingestionJob": { "$ref": "#/components/messages/KnowledgeIngestionJob" } } },
    "knowledgeIngestionEvents": { "address": "domus.v1.knowledge.ingestion.events", "messages": { "ingestionResult": { "$ref": "#/components/messages/KnowledgeIngestionResult" } } },
    "knowledgeGovernanceEvents": { "address": "domus.v1.knowledge.governance.events", "messages": { "governanceEvent": { "$ref": "#/components/messages/KnowledgeGovernanceEvent" } } },
    "contentSafetyEvents": { "address": "domus.v1.knowledge.safety.events", "messages": { "safetyEvent": { "$ref": "#/components/messages/ContentSafetyEvent" } } },
    "taxonomyEvents": { "address": "domus.v1.knowledge.taxonomy.events", "messages": { "taxonomyEvent": { "$ref": "#/components/messages/TaxonomyEvent" } } },
    "knowledgeGraphEvents": { "address": "domus.v1.knowledge.graph.events", "messages": { "graphEvent": { "$ref": "#/components/messages/KnowledgeGraphEvent" } } }
  },
  "operations": {
    "sendIdentityEvent": { "action": "send", "channel": { "$ref": "#/channels/identityEvents" } },
    "sendTenancyEvent": { "action": "send", "channel": { "$ref": "#/channels/tenancyEvents" } },
    "consumeIngestionJob": { "action": "receive", "channel": { "$ref": "#/channels/ingestionJobs" } },
    "sendKnowledgeEvent": { "action": "send", "channel": { "$ref": "#/channels/knowledgeEvents" } },
    "sendIntelligenceEvent": { "action": "send", "channel": { "$ref": "#/channels/intelligenceEvents" } },
    "sendActionEvent": { "action": "send", "channel": { "$ref": "#/channels/actionEvents" } },
    "sendSourceEvent": { "action": "send", "channel": { "$ref": "#/channels/sourceEvents" } },
    "consumeConnectorJob": { "action": "receive", "channel": { "$ref": "#/channels/connectorJobs" } },
    "sendConnectorEvent": { "action": "send", "channel": { "$ref": "#/channels/connectorEvents" } },
    "sendKnowledgeObjectEvent": { "action": "send", "channel": { "$ref": "#/channels/knowledgeObjectEvents" } },
    "consumeKnowledgeIngestionJob": { "action": "receive", "channel": { "$ref": "#/channels/knowledgeIngestionJobs" } },
    "sendKnowledgeIngestionResult": { "action": "send", "channel": { "$ref": "#/channels/knowledgeIngestionEvents" } },
    "sendKnowledgeGovernanceEvent": { "action": "send", "channel": { "$ref": "#/channels/knowledgeGovernanceEvents" } },
    "sendContentSafetyEvent": { "action": "send", "channel": { "$ref": "#/channels/contentSafetyEvents" } },
    "sendTaxonomyEvent": { "action": "send", "channel": { "$ref": "#/channels/taxonomyEvents" } },
    "sendKnowledgeGraphEvent": { "action": "send", "channel": { "$ref": "#/channels/knowledgeGraphEvents" } }
  },
  "components": { "messages": {
    "IdentityEvent": { "name": "IdentityEventV1", "title": "Evento de identidade sem dados de autenticação", "payload": { "$ref": "../../json-schema/v1/identity-event.schema.json" } },
    "TenancyEvent": { "name": "TenancyEventV1", "title": "Evento administrativo de tenant/workspace", "payload": { "$ref": "../../json-schema/v1/tenancy-event.schema.json" } },
    "DomainEvent": { "name": "DomainEventV1", "title": "Evento cross-runtime versionado", "payload": { "$ref": "../../json-schema/v1/domain-event.schema.json" } },
    "KnowledgeAssetJob": { "name": "KnowledgeAssetJobV1", "title": "Job de ingestão versionado", "payload": { "$ref": "../../json-schema/v1/knowledge-asset.schema.json" } },
    "SourceLifecycleEvent": { "name": "SourceLifecycleEventV1", "title": "Evento governado de ciclo de vida da fonte", "payload": { "$ref": "../../json-schema/v1/source-lifecycle-event.schema.json" } },
    "ConnectorSyncJob": { "name": "ConnectorSyncJobV1", "title": "Job de sync com fencing", "payload": { "$ref": "../../json-schema/v1/connector-sync-job.schema.json" } },
    "ConnectorSyncEvent": { "name": "ConnectorSyncEventV1", "title": "Resultado sanitizado de sync", "payload": { "$ref": "../../json-schema/v1/connector-sync-event.schema.json" } },
    "KnowledgeObjectEvent": { "name": "KnowledgeObjectLifecycleEventV1", "title": "Lifecycle de objeto sem conteúdo", "payload": { "$ref": "../../json-schema/v1/knowledge-object-lifecycle-event.schema.json" } },
    "KnowledgeIngestionJob": { "name": "KnowledgeIngestionJobV1", "title": "Job governado para versão exata do original", "payload": { "$ref": "../../json-schema/v1/knowledge-ingestion-job.schema.json" } },
    "KnowledgeIngestionResult": { "name": "KnowledgeIngestionResultV1", "title": "Estado de ingestão sem conteúdo", "payload": { "$ref": "../../json-schema/v1/knowledge-ingestion-result.schema.json" } },
    "KnowledgeGovernanceEvent": { "name": "KnowledgeGovernanceEventV1", "title": "Vigência e aprovação sem conteúdo", "payload": { "$ref": "../../json-schema/v1/knowledge-governance-event.schema.json" } },
    "ContentSafetyEvent": { "name": "ContentSafetyEventV1", "title": "Decisão safety sem conteúdo", "payload": { "$ref": "../../json-schema/v1/content-safety-event.schema.json" } },
    "TaxonomyEvent": { "name": "TaxonomyEventV1", "title": "Taxonomia versionada sem definições", "payload": { "$ref": "../../json-schema/v1/taxonomy-event.schema.json" } },
    "KnowledgeGraphEvent": { "name": "KnowledgeGraphEventV1", "title": "Graph Lite sem conteúdo", "payload": { "$ref": "../../json-schema/v1/knowledge-graph-event.schema.json" } }
  } }
}
